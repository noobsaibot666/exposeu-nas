{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": ".tmp-tests",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "tests/**/*.ts",
    "src/i18n/routing.ts",
    "src/i18n/seoUrl.ts",
    "src/i18n/pageMetaConfig.ts"
  ]
}
