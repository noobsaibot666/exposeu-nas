SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@email.com
SMTP_PASS=your_app_password_here

# Outreach-app Supabase project — logs contact submissions for the ads dashboard export.
# Optional: if unset, the contact form still works, submissions just aren't logged.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Analytics (GA4, Clarity, Meta Pixel)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_CLARITY_ID=your_clarity_id_here
VITE_META_PIXEL_ID=your_pixel_id_here

# Meta Conversions API (server-side)
META_PIXEL_ID=your_pixel_id_here
META_CAPI_TOKEN=your_meta_capi_access_token_here
# Optional: use Meta Events Manager Test Events code during testing
META_TEST_EVENT_CODE=
