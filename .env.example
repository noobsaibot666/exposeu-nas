SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@email.com
SMTP_PASS=your_app_password_here

# Outreach-app Supabase project — logs contact submissions for the ads dashboard export.
# Optional: if unset, the contact form still works, submissions just aren't logged.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Analytics (GA4, Clarity, Meta Pixel)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_CLARITY_ID=your_clarity_id_here
VITE_META_PIXEL_ID=your_pixel_id_here

# Optional CDN/R2 base for the hero MP4s. Blank = self-hosted /assets/media
# (public/assets/media/). Vimeo is the automatic fallback if the files fail.
# Expected objects: <base>/home-hero-desktop-v1.mp4 and <base>/home-hero-mobile-v1.mp4
VITE_HOME_HERO_VIDEO_BASE_URL=

# Pricing request destination (required to submit /pricing-request/:plan)
# Configure this in the deployment build environment; leave empty if not enabled.
VITE_PRICING_FORM_ENDPOINT=

# Meta Conversions API (server-side)
META_PIXEL_ID=your_pixel_id_here
META_CAPI_TOKEN=your_meta_capi_access_token_here
# Optional: use Meta Events Manager Test Events code during testing
META_TEST_EVENT_CODE=
